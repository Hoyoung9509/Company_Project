generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ──────────────────────────────────────────
// 계정 / 인증
// ──────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  employeeId   String    @unique          // 사원번호
  email        String    @unique
  passwordHash String
  name         String
  department   String
  position     String
  phone        String?
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions          Session[]
  draftedApprovals  Approval[]      @relation("Drafter")
  approvalSteps     ApprovalStep[]
  auditLogs         AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  EMPLOYEE  // 일반 직원
  MANAGER   // 팀장
  ADMIN     // 어드민 (사이트 전체 관리자)
}

// ──────────────────────────────────────────
// 결재 시스템
// ──────────────────────────────────────────

model Approval {
  id        String         @id @default(cuid())
  title     String
  content   String         @db.Text
  status    ApprovalStatus @default(DRAFT)
  drafterId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  drafter     User           @relation("Drafter", fields: [drafterId], references: [id])
  steps       ApprovalStep[]
  logs        ApprovalLog[]
  attachments Attachment[]

  @@index([drafterId])
  @@index([status])
}

model ApprovalStep {
  id         String   @id @default(cuid())
  approvalId String
  reviewerId String
  order      Int
  createdAt  DateTime @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  reviewer User     @relation(fields: [reviewerId], references: [id])

  @@index([approvalId])
}

// 결재 이력 — 삭제 불가, 감사 목적으로 영구 보존
model ApprovalLog {
  id         String       @id @default(cuid())
  approvalId String
  actorId    String?      // null = 시스템
  action     ApprovalAction
  comment    String?
  createdAt  DateTime     @default(now())

  approval Approval @relation(fields: [approvalId], references: [id])

  @@index([approvalId])
}

enum ApprovalStatus {
  DRAFT      // 기안 중
  IN_REVIEW  // 결재 진행 중
  APPROVED   // 승인 완료
  REJECTED   // 반려
}

enum ApprovalAction {
  SUBMITTED  // 기안 제출
  APPROVED   // 승인
  REJECTED   // 반려
  RESUBMITTED // 재기안
  CANCELLED  // 취소
  ADMIN_OVERRIDE // 어드민 강제 처리
}

// ──────────────────────────────────────────
// 공개 콘텐츠
// ──────────────────────────────────────────

model Content {
  id          String        @id @default(cuid())
  type        ContentType
  title       String
  body        String        @db.LongText
  mediaUrl    String?       // 유튜브 등 영상 링크 (WORK 타입에서 사용)
  isPublished Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  attachments Attachment[]
}

enum ContentType {
  ABOUT        // 회사 소개
  SERVICE      // 서비스 소개
  CAREER       // 채용 공고
  NOTICE_PUBLIC  // 공지 (외부)
  NOTICE_INTERNAL // 공지 (내부)
  WORK         // 작업물 (동요/영상 홍보)
}

// ──────────────────────────────────────────
// 파일 첨부
// ──────────────────────────────────────────

model Attachment {
  id         String   @id @default(cuid())
  fileName   String
  fileUrl    String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  approvalId String?
  contentId  String?

  approval Approval? @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  content  Content?  @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────
// 어드민 감사 로그 — 삭제 불가
// ──────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String   // 예: "USER_DEACTIVATED", "CONTENT_PUBLISHED"
  targetType String   // 예: "User", "Content", "Approval"
  targetId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
}
